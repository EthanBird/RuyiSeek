import { Button, CheckBox, LineEdit } from "std-widgets.slint";

export struct LauncherResult {
    title: string,
    path: string,
    kind: string,
    score: string,
}

component SettingsPanel inherits Rectangle {
    callback save-settings(bool, bool, bool);
    callback close-settings();

    in-out property <bool> launch-at-login: false;
    in-out property <bool> double-ctrl-enabled: true;
    in-out property <bool> suppress-in-fullscreen: true;
    in property <string> status-text: "修改后点击保存";

    background: #f7fafc;
    border-color: #c7d4df;
    border-width: 1px;
    border-radius: 16px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #10263a38;
    drop-shadow-offset-y: 8px;
    clip: true;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        HorizontalLayout {
            height: 52px;

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "如意寻设置";
                    color: #152735;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "常规与唤醒";
                    color: #71818e;
                    font-size: 12px;
                }
            }

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: close-touch.has-hover ? #e2eaf0 : transparent;

                Text {
                    text: "×";
                    color: #536574;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    clicked => { root.close-settings(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #dce5ec;
        }

        VerticalLayout {
            spacing: 10px;

            Text {
                text: "启动";
                color: #176b87;
                font-size: 13px;
                font-weight: 700;
            }

            Rectangle {
                height: 72px;
                border-radius: 12px;
                background: #edf4f7;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;

                    VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "登录后自动启动";
                            color: #203442;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: "在 Deepin / UOS 桌面会话中常驻托盘";
                            color: #71818e;
                            font-size: 11px;
                        }
                    }

                    CheckBox {
                        text: "启用";
                        checked <=> root.launch-at-login;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 10px;

            Text {
                text: "全局唤醒";
                color: #176b87;
                font-size: 13px;
                font-weight: 700;
            }

            Rectangle {
                height: 72px;
                border-radius: 12px;
                background: #edf4f7;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;

                    VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "双击 Ctrl 呼出搜索框";
                            color: #203442;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: "X11 下监听原始按键，但不会抓取或吞键";
                            color: #71818e;
                            font-size: 11px;
                        }
                    }

                    CheckBox {
                        text: "启用";
                        checked <=> root.double-ctrl-enabled;
                    }
                }
            }

            Rectangle {
                height: 72px;
                border-radius: 12px;
                background: #edf4f7;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;

                    VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "全屏时暂停唤醒";
                            color: #203442;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: "避免游戏、演示和视频播放时误触发";
                            color: #71818e;
                            font-size: 11px;
                        }
                    }

                    CheckBox {
                        text: "启用";
                        checked <=> root.suppress-in-fullscreen;
                    }
                }
            }
        }

        HorizontalLayout {
            height: 42px;

            Text {
                text: root.status-text;
                color: #71818e;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }

            Button {
                width: 108px;
                text: "保存设置";
                clicked => {
                    root.save-settings(
                        root.launch-at-login,
                        root.double-ctrl-enabled,
                        root.suppress-in-fullscreen
                    );
                }
            }
        }
    }
}

export component LauncherWindow inherits Window {
    callback query-edited(string);
    callback activate-result(int);
    callback reveal-result(int);
    callback copy-file(int);
    callback copy-path(int);
    callback dismiss();
    callback save-settings(bool, bool, bool);
    callback close-settings();

    public function focus-query() {
        query-input.focus();
    }

    in property <[LauncherResult]> results: [];
    in property <string> status-text: "正在连接后台服务…";
    in-out property <string> query: "";
    in-out property <int> selected-index: 0;
    in-out property <int> popup-index: -1;
    in-out property <bool> settings-mode: false;
    in-out property <bool> launch-at-login: false;
    in-out property <bool> double-ctrl-enabled: true;
    in-out property <bool> suppress-in-fullscreen: true;
    in property <string> settings-status-text: "修改后点击保存";
    // 结果 Flickable 当前滚出去的像素数，context-menu 用这个来对齐被
    // 右键的行，而不是跟着 viewport 漂走。在 Flickable 内部通过
    // `<=>` 双向绑定到 `results_flickable.viewport-y`，这样滑块
    // 一动 context-menu 立刻知道。
    in-out property <length> results-viewport-y: 0;
    // 同时露在屏幕上的结果行数上限（超出部分在 Flickable 内滚动）。
    // 默认 10 行 ≈ 540px 高，再多就把 960x600 的居中窗口顶到屏幕外了。
    in-out property <int> visible-rows: 10;

    title: root.settings-mode ? "如意寻设置" : "如意寻";
    // 启动器面板始终占满整个屏幕，目的是让"点击面板外的空白区域"等价于
    // "点击启动器以外的地方" —— 用户在屏幕任意空白处点击都直接隐藏。
    // 真正的卡片（focus-scope）固定为 720 宽，按结果数动态算高度，并被
    // 居中放置在窗口内。drop-shadow 需要的边距由 focus-scope 的居中位移
    // 自然留出。
    width: 960px;
    height: 600px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // 最底层铺一张全窗口的"空白点击区"，命中后调用 dismiss() 隐藏启动器。
    // 在 source 顺序上它先于 focus-scope 与 context-menu，所以焦点卡上的
    // TouchArea / LineEdit / Rectangle 仍然优先吃事件；只有真正的"卡片
    // 之外 + context-menu 之外"区域才会到这里。Slint 1.6 里 Window 的非
    // 布局子元素不会自动拉伸，所以这里显式绑到 parent.width/height。
    dismiss-area := Rectangle {
        background: transparent;
        width: parent.width;
        height: parent.height;
        dismiss-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.dismiss();
            }
        }
    }

    focus-scope := FocusScope {
        // Slint 1.6 的 key 事件链 child-first：LineEdit 内部的 TextInput 占据
        // focus_item，并把方向键 / Home / End / Backspace / Delete / Ctrl+A/C/V/X
        // / Ctrl+Left/Right 等都吃掉用于光标或选区。父级 key-pressed 看不到这些键。
        // 这里只处理 TextInput 不吃的键：PageUp/Down、Escape、Ctrl+P/N/L。
        // 方向键（↑↓←→）单独在 Rust 端拦截后回灌到 selected-index，逻辑在
        // apps/ruyiseek-ui/src/main.rs::apply_arrow_to_selection，事件源是
        // crates/ruyiseek-platform/src/x11_hotkey.rs 的 on_arrow 回调（XInput2 raw stream）。
        visible: !root.settings-mode;
        // 720 宽；高度按结果数算。把焦点卡居中放置在 960x600 窗口内。
        // 高度公式：12 (top pad) + 44 (search bar) + 8 + (28 status 或 N*46 results)
        // + 8 + 12 (bottom pad) ≈ 110 + N*54。
        width: 720px;
        // 窗口高度：搜索栏 12+44、底部 padding 12+8 固定 ~76；中间留给结果
        // 区域，但结果区最大只露 VISIBLE_ROWS 行（其余在 Flickable 里滚动），
        // 避免 50 条结果把窗口撑得比屏幕还高。每行 46px + 间距 8px。
        height: 76px + Math.min(root.results.length, root.visible-rows) * 54px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        key-pressed(event) => {
            // Slint 1.6 的 .slint 端只暴露 event.text（string）和 event.modifiers，
            // 不能访问 event.key。Key.X 常量会隐式转成对应的 Unicode 字符（PUA）
            // 再和 event.text 比较，所以这里全部走 event.text == Key.X 的写法。
            if (event.text == Key.PageDown && root.results.length > 0) {
                root.selected-index = Math.min(root.selected-index + 5, root.results.length - 1);
                return accept;
            }
            if (event.text == Key.PageUp && root.results.length > 0) {
                root.selected-index = Math.max(root.selected-index - 5, 0);
                return accept;
            }
            // Key enum 里没有字母键，Ctrl+P/N/L 只能通过 event.text 比对。
            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                    && (event.text == "p" || event.text == "n") && root.results.length > 0) {
                root.selected-index = event.text == "p"
                    ? Math.max(root.selected-index - 1, 0)
                    : Math.min(root.selected-index + 1, root.results.length - 1);
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                    && event.text == "l" && root.query != "") {
                root.query = "";
                root.selected-index = 0;
                root.query-edited("");
                return accept;
            }
            if (event.text == Key.Escape) {
                // 按 Esc 直接隐藏启动器，不再"先清空内容再隐藏"两段式。
                // 用户若想清空当前输入，用 Ctrl+L 或手动选中删除。
                root.dismiss();
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: #f7fafcee;
            border-color: #cbd7e3aa;
            border-width: 1px;
            border-radius: 16px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #10263a45;
            drop-shadow-offset-y: 10px;
            clip: true;

            // 卡片"空白处点击吸收器"。放在最底层（source 顺序先于结果行 / 搜索
            // 条），命中后将焦点送回搜索框 —— 这样：
            //  - 点击 padding / 状态文字等无控件区域：不会触发外层 dismiss
            //    TouchArea（从而不会意外隐藏），只会把焦点放回搜索框；
            //  - 点击结果行 / 搜索框：被它们各自的 TouchArea / LineEdit 优先
            //    吃掉，事件不到这里。
            card-bg-touch := TouchArea {
                clicked => {
                    query-input.focus();
                }
            }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    height: 44px;
                    spacing: 0px;

                    query-input := LineEdit {
                        height: 44px;
                        text <=> root.query;
                        placeholder-text: "搜索文件、文件夹、应用或命令…";
                        font-size: 18px;

                        edited(text) => {
                            root.popup-index = -1;
                            root.selected-index = 0;
                            root.query-edited(text);
                        }
                        accepted(text) => {
                            if (root.results.length > 0) {
                                root.activate-result(root.selected-index);
                            }
                        }
                    }
                }

                if root.results.length == 0 : Rectangle {
                    height: 28px;

                    Text {
                        text: root.status-text;
                        color: #71818e;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // 结果列表：results 最多 SEARCH_LIMIT=50 条，窗口里
                // 最多露 visible-rows 行（默认 10），其余通过 Flickable
                // 滚动查看。Flickable 的 viewport-y 实时反映滚动位置，
                // 上下文菜单位置要减去这个偏移，否则菜单会跟着 viewport
                // 漂走。
                if root.results.length > 0 : results_flickable := Flickable {
                    height: Math.min(root.results.length, root.visible-rows) * 46px;
                    viewport-height: root.results.length * 46px;
                    // 鼠标滚轮不会触发焦点转移，键盘 PageUp/PageDown
                    // 由 focus-scope.key-pressed 接管。
                    viewport-y <=> root.results-viewport-y;
                    VerticalLayout {
                        spacing: 0px;
                        for result[index] in root.results : Rectangle {
                            height: 46px;
                            border-radius: 10px;
                            background: index == root.selected-index
                                ? #dcecf2
                                : result-touch.has-hover ? #edf4f7 : transparent;

                            result-touch := TouchArea {
                                // 左键：若右键菜单正打开，则只关闭菜单不触发打开；
                                // 用户需二次点击才打开所选项，符合常见 UX。
                                // 右键：选中该行并弹出上下文菜单，位置由 popup-index 计算。
                                clicked => {
                                    root.selected-index = index;
                                    if (root.popup-index < 0) {
                                        root.activate-result(index);
                                    } else {
                                        root.popup-index = -1;
                                    }
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.up) {
                                        root.selected-index = index;
                                        root.popup-index = index;
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 9px;
                                    background: result.kind == "文件夹" ? #d9eee7 : #e8edf2;

                                    Text {
                                        text: result.kind == "文件夹" ? "夹" : "文";
                                        color: result.kind == "文件夹" ? #26765e : #52697b;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 1px;

                                    Text {
                                        text: result.title;
                                        color: #152735;
                                        font-size: 14px;
                                        font-weight: index == root.selected-index ? 600 : 400;
                                        overflow: elide;
                                        vertical-alignment: bottom;
                                    }

                                    Text {
                                        text: result.path;
                                        color: #71818e;
                                        font-size: 11px;
                                        overflow: elide;
                                        vertical-alignment: top;
                                    }
                                }

                                Text {
                                    width: 46px;
                                    text: result.score;
                                    color: #81909b;
                                    font-size: 10px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 右键弹出的上下文菜单，定义在 Window 顶层（focus-scope 之外）以保证 z-order
    // 在结果行之上。Slint 1.6 没有内置 PopupMenu/MenuItem，这里手写一个浮层
    // 菜单：每个动作是一个 Rectangle + TouchArea，命中后回调到 Rust 并把
    // popup-index 重置回 -1 完成关闭。位置相对 focus-scope 的左上角：focus-scope
    // 已经用 x/y 居中放置，菜单同样相对 focus-scope 定位，保证在不同窗口大小下
    // 菜单与被右键的结果行对齐。
    context-menu := Rectangle {
        visible: root.popup-index >= 0 && !root.settings-mode;
        width: 188px;
        height: 4 * 32px + 8px;
        x: focus-scope.x + 12px;
        // viewport-y 是结果区 Flickable 当前滚出去的像素数；菜单
        // 必须跟着滚动，否则用户滚到第 30 行右键，菜单还会停在
        // 第 popup-index 行的位置上，完全错位。
        y: focus-scope.y + 82px + root.popup-index * 46px + 2px - root.results-viewport-y;
        border-radius: 8px;
        background: #f7fafcee;
        border-color: #cbd7e3aa;
        border-width: 1px;
        drop-shadow-blur: 14px;
        drop-shadow-color: #10263a40;
        drop-shadow-offset-y: 6px;
        clip: true;

        VerticalLayout {
            padding: 4px;
            spacing: 0px;

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: open-touch.has-hover ? #dcecf2 : transparent;

                open-touch := TouchArea {
                    clicked => {
                        root.activate-result(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "打开";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: reveal-touch.has-hover ? #dcecf2 : transparent;

                reveal-touch := TouchArea {
                    clicked => {
                        root.reveal-result(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "打开所在文件夹";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: copy-touch.has-hover ? #dcecf2 : transparent;

                copy-touch := TouchArea {
                    clicked => {
                        root.copy-file(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "复制文件";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: copy-path-touch.has-hover ? #dcecf2 : transparent;

                copy-path-touch := TouchArea {
                    clicked => {
                        root.copy-path(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "复制路径";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }
        }
    }

    SettingsPanel {
        visible: root.settings-mode;
        launch-at-login <=> root.launch-at-login;
        double-ctrl-enabled <=> root.double-ctrl-enabled;
        suppress-in-fullscreen <=> root.suppress-in-fullscreen;
        status-text: root.settings-status-text;
        // 与 focus-scope 同样的居中策略：固定 640x480，屏窗中央。
        width: 640px;
        height: 480px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        close-settings => { root.close-settings(); }
        save-settings(launch-at-login, double-ctrl-enabled, suppress-in-fullscreen) => {
            root.save-settings(
                launch-at-login,
                double-ctrl-enabled,
                suppress-in-fullscreen
            );
        }
    }
}
