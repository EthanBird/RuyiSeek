import { Button, CheckBox, LineEdit } from "std-widgets.slint";

export struct LauncherResult {
    title: string,
    path: string,
    kind: string,
    score: string,
}

component SettingsPanel inherits Rectangle {
    callback save-settings(bool, bool, bool);
    callback close-settings();

    in-out property <bool> launch-at-login: false;
    in-out property <bool> double-ctrl-enabled: true;
    in-out property <bool> suppress-in-fullscreen: true;
    in property <string> status-text: "修改后点击保存";

    background: #f7fafc;
    border-color: #c7d4df;
    border-width: 1px;
    border-radius: 16px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #10263a38;
    drop-shadow-offset-y: 8px;
    clip: true;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        HorizontalLayout {
            height: 52px;

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "如意寻设置";
                    color: #152735;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "常规与唤醒";
                    color: #71818e;
                    font-size: 12px;
                }
            }

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: close-touch.has-hover ? #e2eaf0 : transparent;

                Text {
                    text: "×";
                    color: #536574;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    clicked => { root.close-settings(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #dce5ec;
        }

        VerticalLayout {
            spacing: 10px;

            Text {
                text: "启动";
                color: #176b87;
                font-size: 13px;
                font-weight: 700;
            }

            Rectangle {
                height: 72px;
                border-radius: 12px;
                background: #edf4f7;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;

                    VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "登录后自动启动";
                            color: #203442;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: "在 Deepin / UOS 桌面会话中常驻托盘";
                            color: #71818e;
                            font-size: 11px;
                        }
                    }

                    CheckBox {
                        text: "启用";
                        checked <=> root.launch-at-login;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 10px;

            Text {
                text: "全局唤醒";
                color: #176b87;
                font-size: 13px;
                font-weight: 700;
            }

            Rectangle {
                height: 72px;
                border-radius: 12px;
                background: #edf4f7;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;

                    VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "双击 Ctrl 呼出搜索框";
                            color: #203442;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: "X11 下监听原始按键，但不会抓取或吞键";
                            color: #71818e;
                            font-size: 11px;
                        }
                    }

                    CheckBox {
                        text: "启用";
                        checked <=> root.double-ctrl-enabled;
                    }
                }
            }

            Rectangle {
                height: 72px;
                border-radius: 12px;
                background: #edf4f7;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;

                    VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "全屏时暂停唤醒";
                            color: #203442;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: "避免游戏、演示和视频播放时误触发";
                            color: #71818e;
                            font-size: 11px;
                        }
                    }

                    CheckBox {
                        text: "启用";
                        checked <=> root.suppress-in-fullscreen;
                    }
                }
            }
        }

        HorizontalLayout {
            height: 42px;

            Text {
                text: root.status-text;
                color: #71818e;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }

            Button {
                width: 108px;
                text: "保存设置";
                clicked => {
                    root.save-settings(
                        root.launch-at-login,
                        root.double-ctrl-enabled,
                        root.suppress-in-fullscreen
                    );
                }
            }
        }
    }
}

export component LauncherWindow inherits Window {
    callback query-edited(string);
    callback activate-result(int);
    callback reveal-result(int);
    callback copy-file(int);
    callback copy-path(int);
    callback dismiss();
    callback save-settings(bool, bool, bool);
    callback close-settings();

    public function focus-query() {
        query-input.focus();
    }

    in property <[LauncherResult]> results: [];
    in property <string> status-text: "正在连接后台服务…";
    in-out property <string> query: "";
    in-out property <int> selected-index: 0;
    in-out property <int> popup-index: -1;
    in-out property <bool> settings-mode: false;
    in-out property <bool> launch-at-login: false;
    in-out property <bool> double-ctrl-enabled: true;
    in-out property <bool> suppress-in-fullscreen: true;
    in property <string> settings-status-text: "修改后点击保存";

    title: root.settings-mode ? "如意寻设置" : "如意寻";
    width: root.settings-mode ? 640px : 720px;
    height: root.settings-mode ? 480px : 122px + Math.min(root.results.length, 9) * 54px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    focus-scope := FocusScope {
        // Slint 1.6 的 key 事件链 child-first：LineEdit 内部的 TextInput 占据
        // focus_item，并把方向键 / Home / End / Backspace / Delete / Ctrl+A/C/V/X
        // / Ctrl+Left/Right 等都吃掉用于光标或选区。父级 key-pressed 看不到这些键。
        // 这里只处理 TextInput 不吃的键：PageUp/Down、Escape、Ctrl+P/N/L。
        // 方向键（↑↓←→）单独在 Rust 端拦截后回灌到 selected-index，逻辑在
        // apps/ruyiseek-ui/src/main.rs::apply_arrow_to_selection，事件源是
        // crates/ruyiseek-platform/src/x11_hotkey.rs 的 on_arrow 回调（XInput2 raw stream）。
        visible: !root.settings-mode;
        key-pressed(event) => {
            // Slint 1.6 的 .slint 端只暴露 event.text（string）和 event.modifiers，
            // 不能访问 event.key。Key.X 常量会隐式转成对应的 Unicode 字符（PUA）
            // 再和 event.text 比较，所以这里全部走 event.text == Key.X 的写法。
            if (event.text == Key.PageDown && root.results.length > 0) {
                root.selected-index = Math.min(root.selected-index + 5, root.results.length - 1);
                return accept;
            }
            if (event.text == Key.PageUp && root.results.length > 0) {
                root.selected-index = Math.max(root.selected-index - 5, 0);
                return accept;
            }
            // Key enum 里没有字母键，Ctrl+P/N/L 只能通过 event.text 比对。
            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                    && (event.text == "p" || event.text == "n") && root.results.length > 0) {
                root.selected-index = event.text == "p"
                    ? Math.max(root.selected-index - 1, 0)
                    : Math.min(root.selected-index + 1, root.results.length - 1);
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                    && event.text == "l" && root.query != "") {
                root.query = "";
                root.selected-index = 0;
                root.query-edited("");
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.query != "") {
                    root.query = "";
                    root.query-edited("");
                } else {
                    root.dismiss();
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: #f7fafcee;
            border-color: #cbd7e3aa;
            border-width: 1px;
            border-radius: 16px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #10263a45;
            drop-shadow-offset-y: 10px;
            clip: true;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    height: 62px;
                    spacing: 12px;

                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 12px;
                        background: #176b87;

                        Text {
                            text: "寻";
                            color: white;
                            font-size: 21px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    query-input := LineEdit {
                        height: 42px;
                        text <=> root.query;
                        placeholder-text: "搜索文件、文件夹、应用或命令";
                        font-size: 19px;

                        edited(text) => {
                            root.popup-index = -1;
                            root.selected-index = 0;
                            root.query-edited(text);
                        }
                        accepted(text) => {
                            if (root.results.length > 0) {
                                root.activate-result(root.selected-index);
                            }
                        }
                    }

                    Rectangle {
                        width: 66px;
                        height: 28px;
                        border-radius: 8px;
                        background: #e6edf3;

                        Text {
                            text: "Ctrl ×2";
                            color: #536574;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.results.length == 0 : Rectangle {
                    height: 28px;

                    Text {
                        text: root.status-text;
                        color: #71818e;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                for result[index] in root.results : Rectangle {
                    height: 46px;
                    border-radius: 10px;
                    background: index == root.selected-index
                        ? #dcecf2
                        : result-touch.has-hover ? #edf4f7 : transparent;

                    result-touch := TouchArea {
                        // 左键：若右键菜单正打开，则只关闭菜单不触发打开；
                        // 用户需二次点击才打开所选项，符合常见 UX。
                        // 右键：选中该行并弹出上下文菜单，位置由 popup-index 计算。
                        clicked => {
                            root.selected-index = index;
                            if (root.popup-index < 0) {
                                root.activate-result(index);
                            } else {
                                root.popup-index = -1;
                            }
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right
                                    && event.kind == PointerEventKind.up) {
                                root.selected-index = index;
                                root.popup-index = index;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 10px;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 9px;
                            background: result.kind == "文件夹" ? #d9eee7 : #e8edf2;

                            Text {
                                text: result.kind == "文件夹" ? "夹" : "文";
                                color: result.kind == "文件夹" ? #26765e : #52697b;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 1px;

                            Text {
                                text: result.title;
                                color: #152735;
                                font-size: 14px;
                                font-weight: index == root.selected-index ? 600 : 400;
                                overflow: elide;
                                vertical-alignment: bottom;
                            }

                            Text {
                                text: result.path;
                                color: #71818e;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: top;
                            }
                        }

                        Text {
                            width: 46px;
                            text: result.score;
                            color: #81909b;
                            font-size: 10px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // 右键弹出的上下文菜单，定义在 Window 顶层（focus-scope 之外）以保证 z-order
    // 在结果行之上。Slint 1.6 没有内置 PopupMenu/MenuItem，这里手写一个浮层
    // 菜单：每个动作是一个 Rectangle + TouchArea，命中后回调到 Rust 并把
    // popup-index 重置回 -1 完成关闭。
    context-menu := Rectangle {
        visible: root.popup-index >= 0 && !root.settings-mode;
        width: 188px;
        height: 4 * 32px + 8px;
        // 浮在主卡左侧、对应结果行的位置上。结果区起始 y 大约是
        // 12 (外 padding) + 62 (搜索条) + 8 (spacing) = 82px。
        x: 12px;
        y: 82px + root.popup-index * 46px + 2px;
        border-radius: 8px;
        background: #f7fafcee;
        border-color: #cbd7e3aa;
        border-width: 1px;
        drop-shadow-blur: 14px;
        drop-shadow-color: #10263a40;
        drop-shadow-offset-y: 6px;
        clip: true;

        VerticalLayout {
            padding: 4px;
            spacing: 0px;

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: open-touch.has-hover ? #dcecf2 : transparent;

                open-touch := TouchArea {
                    clicked => {
                        root.activate-result(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "打开";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: reveal-touch.has-hover ? #dcecf2 : transparent;

                reveal-touch := TouchArea {
                    clicked => {
                        root.reveal-result(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "打开所在文件夹";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: copy-touch.has-hover ? #dcecf2 : transparent;

                copy-touch := TouchArea {
                    clicked => {
                        root.copy-file(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "复制文件";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }

            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: copy-path-touch.has-hover ? #dcecf2 : transparent;

                copy-path-touch := TouchArea {
                    clicked => {
                        root.copy-path(root.popup-index);
                        root.popup-index = -1;
                    }
                }

                Text {
                    text: "复制路径";
                    color: #152735;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    x: 12px;
                    width: parent.width - 24px;
                }
            }
        }
    }

    SettingsPanel {
        visible: root.settings-mode;
        launch-at-login <=> root.launch-at-login;
        double-ctrl-enabled <=> root.double-ctrl-enabled;
        suppress-in-fullscreen <=> root.suppress-in-fullscreen;
        status-text: root.settings-status-text;
        close-settings => { root.close-settings(); }
        save-settings(launch-at-login, double-ctrl-enabled, suppress-in-fullscreen) => {
            root.save-settings(
                launch-at-login,
                double-ctrl-enabled,
                suppress-in-fullscreen
            );
        }
    }
}
