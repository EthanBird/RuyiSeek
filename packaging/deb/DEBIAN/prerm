#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop any running processes started outside of systemd.
        for proc in ruyiseek-ui ruyiseekd ruyi; do
            pids=$(pgrep -x "$proc" 2>/dev/null || true)
            if [ -n "$pids" ]; then
                kill $pids 2>/dev/null || true
            fi
        done
        ;;
    failed-upgrade)
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
