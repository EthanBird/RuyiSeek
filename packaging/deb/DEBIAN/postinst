#!/bin/sh
set -e

case "$1" in
    configure)
        # Reload D-Bus session service activation cache so the
        # io.github.ethanbird.RuyiSeek.service becomes activatable.
        if [ -d /run/user ]; then
            for bus in /run/user/*/bus; do
                [ -S "$bus" ] || continue
                dbus-send --address="unix:path=$bus" --type=method_call \
                    --dest=org.freedesktop.DBus / org.freedesktop.DBUS.ReloadConfig \
                    >/dev/null 2>&1 || true
            done
        fi

        # Try to enable the systemd user units for every logged-in user.
        # This is best-effort: postinst runs as root, not as the user,
        # so USERBASE discovery is approximate.
        for uid_dir in /run/user/*; do
            [ -d "$uid_dir" ] || continue
            uid=$(basename "$uid_dir")
            user=$(getent passwd "$uid" | cut -d: -f1)
            [ -n "$user" ] || continue
            loginctl enable-linger "$user" 2>/dev/null || true
        done

        cat <<'EOF'
如意寻 RuyiSeek 已安装。

使用方式：
  * 点击桌面 launcher "如意寻"，或按两下 Ctrl 唤出启动器。
  * ruyiseek-ui 会在后台自动启动 ruyiseekd 搜索服务，无需手工配置。
  * 设置窗口：`ruyiseek-ui --settings`。
  * CLI 查询：`ruyi search <关键词>`。
  * 仅后台运行（托盘 + 双击 Ctrl + D-Bus 激活）：`ruyiseek-ui --background`。
  * 退出全部：`ruyiseek-ui --quit`（同时停掉 ruyiseekd）。

可选：登录即后台常驻。注销重新登录后，
/etc/xdg/autostart/io.github.ethanbird.RuyiSeek.desktop 会自动启动
UI 托盘；也可手动启用 systemd 用户单元：
  systemctl --user enable --now ruyiseekd.service
  systemctl --user enable --now ruyiseek-ui.service

如需彻底卸载：apt remove ruyiseek
EOF
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
