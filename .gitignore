/target/
*.sock
*.log
.idea/
.vscode/

# Build outputs from packaging/deb/build.sh
/dist/
# Binaries that build.sh `install`s into the staging tree — regenerated
# on every build, never edited in place.
/packaging/deb/usr/bin/

# Build-time stubs for the musl build (compiled into binaries at
# link time; not part of the source tree that gets reviewed).
# Keep shim.c — it documents the workaround. Ignore shim.o.
/packaging/deb/shim.o

# PNG icons are generated by packaging/deb/build.sh from the SVG via
# rsvg-convert; keep only the vector source in git.
/packaging/icons/*.png

# icons installed into the .deb staging tree are regenerated on every
# build; only the SVG in packaging/icons/ is the canonical source.
/packaging/deb/usr/share/icons/

# Shared libraries + dynamic linker copied into the .deb staging tree
# by packaging/deb/bundle-libs.sh (re-stamped from /lib/x86_64-linux-gnu
# on every build). The authoritative copies live on the build host, the
# .deb ships them, and the staging dir is just a checkout scratch.
/packaging/deb/usr/lib/ruyiseek/